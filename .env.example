# Directory used as the codebase/context for answers (your Obsidian vault).
# This can also be changed live from the Settings panel in the UI.
VAULT_DIR=/home/jj/repos/obsidian-vault

# Port for the web UI
PORT=5173

# Optional. Only needed if Claude Code is NOT already logged in on this machine.
# The app otherwise reuses your existing Claude Code auth automatically.
# ANTHROPIC_API_KEY=sk-ant-...
