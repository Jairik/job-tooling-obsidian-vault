{
  "name": "@jairik/vault-assistant",
  "version": "0.1.0",
  "description": "A multi-tab web UI for asking questions about your Obsidian vault with Claude Code, grounded in what the vault actually says.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jairik/vault-assistant.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "agent",
    "shared",
    "src",
    "tui",
    "server.ts",
    "run.sh",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "NODE_ENV=production bun server.ts",
    "tui": "bun tui/main.tsx",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "@mozilla/readability": "^0.6.0",
    "clipboardy": "^5.3.1",
    "diff": "^9.0.0",
    "ink": "^7.1.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "jsdom": "^29.1.1",
    "mammoth": "^1.12.0",
    "marked": "^15",
    "marked-terminal": "^7.3.0",
    "playwright": "^1.61.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
