{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vault Assistant",
  "version": "0.1.1",
  "identifier": "com.jairik.vaultassistant",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "bash src-tauri/scripts/prepare-sidecar.sh",
    "beforeBuildCommand": "bash src-tauri/scripts/prepare-sidecar.sh && bash src-tauri/scripts/stage-app.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vault Assistant",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "externalBin": ["binaries/bun"],
    "resources": {
      "app/**/*": "app/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {}
  }
}
